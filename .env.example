NEXT_PUBLIC_SITE_URL=https://boldfuse.in
# Optional: Google Maps Embed API key (works without key using the default embed source)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Hiring dashboard & Careers openings (MongoDB + admin sign-in)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
HIRING_ADMIN_EMAIL=hiring@boldfuse.in
HIRING_ADMIN_PASSWORD=

# Careers application email notifications (SMTP — e.g. Hostinger smtp.hostinger.com or Gmail smtp.gmail.com)
HIRING_NOTIFICATION_EMAIL=hiring@boldfuse.in
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hiring@boldfuse.in
SMTP_PASS=
SMTP_FROM="Boldfuse Careers <hiring@boldfuse.in>"
